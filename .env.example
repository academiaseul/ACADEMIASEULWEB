# Variables de entorno de academiaseul.com
# Copia este archivo como .env.local para desarrollo. NUNCA subas .env.local ni .env.production a git:
# los valores reales viven en Vercel → proyecto academiaseulweb → Settings → Environment Variables (Production).

# Mercado Pago · checkout dinámico (app/api/checkout/route.ts).
# Solo se usa para el plan en cuotas mientras MP_LINK_MENSUAL esté vacío en lib/nivel1.ts;
# el pago único abre el link fijo MP_LINK_UNICO (https://mpago.la/1cHrbqy).
MP_ACCESS_TOKEN=
MP_PRICE_CLP_UNICO=150000
MP_PRICE_CLP_MENSUAL=75000

# Resend · correo de aviso cuando Mercado Pago confirma un pago (app/api/mp-webhook/route.ts).
# Si falta, el webhook sigue funcionando pero no envía el aviso.
RESEND_API_KEY=
OWNER_EMAIL=hola.academiaseul@gmail.com

# Base del sitio (links de retorno de pago). En Vercel se deja el dominio de producción.
NEXT_PUBLIC_BASE_URL=https://www.academiaseul.com
